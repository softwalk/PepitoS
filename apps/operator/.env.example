# URL de la API. En `npm run dev` y `npm run preview` Vite hace proxy de /v1 → esta URL.
VITE_API_URL=http://localhost:8000
# Opcional, sólo para producción: URL absoluta de la API que queda embebida en el build.
# Si se omite, la app llama a /v1 relativo y el servidor web debe hacer proxy a la API.
# VITE_API_BASE=https://api.pepito.example.com
