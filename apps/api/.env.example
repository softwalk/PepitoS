# Copia a .env y ajusta. Todas se pueden pasar también como variables de entorno.
DATABASE_URL=postgresql+psycopg://pepito:pepito@localhost:5433/pepito
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-32-bytes
JWT_EXPIRES_HOURS=12
TZ_NAME=America/Mexico_City
RULES_INTERVAL_SECONDS=300
CORS_ORIGINS=*
RUN_SCHEDULER=true
# Base separada usada por pytest (se recrea en cada corrida)
TEST_DATABASE_URL=postgresql+psycopg://pepito:pepito@localhost:5433/pepito_test

# development | staging | production (en producción se exige JWT_SECRET fuerte y CORS_ORIGINS explícito)
APP_ENV=development

# Seed: demo | prod | none. prod crea sólo zona "Default" + admin (ADMIN_INITIAL_PASSWORD, obliga a cambiarla) + catálogo.
# Con APP_ENV=production, SEED_MODE=demo aborta.
SEED_MODE=demo
ADMIN_INITIAL_PASSWORD=

# Rate limiting de login: N fallos por usuario / por IP en LOGIN_WINDOW_MINUTES bloquean LOGIN_LOCK_MINUTES (429 RATE_LIMITED)
LOGIN_MAX_FAILS_USER=5
LOGIN_MAX_FAILS_IP=30
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
LOGIN_ATTEMPTS_RETENTION_DAYS=7

# Refresh tokens rotativos (opacos, ligados al device_id)
REFRESH_EXPIRES_DAYS=30
PASSWORD_MIN_LENGTH=8
