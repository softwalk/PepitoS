# Variables para docker-compose (copiar a .env)
APP_ENV=development
POSTGRES_PASSWORD=pepito
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-32-bytes
CORS_ORIGINS=*
# demo | prod | none. En producción usa prod y define ADMIN_INITIAL_PASSWORD (se pide cambiarla al primer login)
SEED_MODE=demo
ADMIN_INITIAL_PASSWORD=

# --- HTTPS (Caddy) ---
# Host o IP con el que los teléfonos llegan a la VM (sin dominio → CA interna; instalar https://<host>:8446/ca.crt en cada teléfono)
PUBLIC_HOST=192.168.100.164
# Con dominio público: SITE_OPERATOR=https://operador.tudominio.mx  SITE_BACKOFFICE=…  SITE_API=…  CADDY_TLS=
# CADDY_TLS="tls internal" (LAN) | "" (Let's Encrypt)
CADDY_TLS=tls internal

# --- MinIO (evidencias) ---
MINIO_ROOT_USER=pepito
MINIO_ROOT_PASSWORD=pepito-minio-cambiar
STORAGE_BACKEND=s3

# --- Notificaciones (opcional; sin claves sólo se registra en la bitácora) ---
# Genera VAPID con: docker compose exec api python -m app.services.webpush genkeys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@pepito.mx
# WhatsApp de respaldo (Twilio). TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Reportes programados por correo (opcional; sin SMTP se guardan en REPORTS_OUT_DIR) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reportes@pepito.mx
REPORTS_EMAIL_TO=
REPORTS_DAILY_HOUR_LOCAL=7

# --- Límite de peticiones por IP y minuto en la API (0 = desactivado) ---
RATE_LIMIT_PER_MINUTE=600

# --- Mapa del backoffice: servidor de tiles propio para LAN sin internet (opcional, se fija al compilar) ---
# VITE_TILES_URL=http://192.168.100.164:8080/tile/{z}/{x}/{y}.png
