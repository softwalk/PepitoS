# Variables para docker-compose (copiar a .env)
APP_ENV=development
POSTGRES_PASSWORD=pepito
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-32-bytes
CORS_ORIGINS=*
# demo | prod | none. En producción usa prod y define ADMIN_INITIAL_PASSWORD (se pide cambiarla al primer login)
SEED_MODE=demo
ADMIN_INITIAL_PASSWORD=

# --- HTTPS (Caddy) ---
# Host o IP con el que los teléfonos llegan a la VM (sin dominio → CA interna; instalar https://<host>:8446/ca.crt en cada teléfono)
PUBLIC_HOST=192.168.100.164
# Con dominio público: SITE_OPERATOR=https://operador.tudominio.mx  SITE_BACKOFFICE=…  SITE_API=…  CADDY_TLS=
# CADDY_TLS="tls internal" (LAN) | "" (Let's Encrypt)
CADDY_TLS=tls internal

# --- MinIO (evidencias) ---
MINIO_ROOT_USER=pepito
MINIO_ROOT_PASSWORD=pepito-minio-cambiar
STORAGE_BACKEND=s3
